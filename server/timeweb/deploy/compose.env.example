# Copy to /etc/clrs-staging/compose.env, owned by root with mode 0600.
# The API image must be the immutable digest of a separately reviewed build.
CLRS_DOMAIN=api-staging.example.invalid
CLRS_API_IMAGE=registry.example.invalid/clrs/api@sha256:REPLACE_WITH_64_HEX_DIGITS
CLRS_API_ENV_FILE=/etc/clrs-staging/api.env
CLRS_DATABASE_CA_HOST_FILE=/etc/clrs-staging/database-ca.pem
