# Names only. Create /etc/clrs-staging/api.env outside git with actual values.
# For the existing Timeweb MySQL cluster, use a DNS host whose certificate
# matches, the isolated clrs_staging database, and ?sslmode=verify-full.
# Use a dedicated clrs_staging-only DB user, never the old default_db user.
# This file is a template, not a working application configuration.
DATABASE_URL=
DATABASE_CA_FILE=/run/secrets/database-ca.pem
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SESSION_SIGNING_KEY=
