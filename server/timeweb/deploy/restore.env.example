# Create /etc/clrs-staging/restore.env outside git on an operator machine.
# Credentials must reach only a newly created, empty clrs_restore_* database.
RESTORE_PGHOST=postgres.example.invalid
RESTORE_PGPORT=5432
RESTORE_PGUSER=clrs_restore
RESTORE_PGPASSWORD=
RESTORE_PGSSLMODE=verify-full
RESTORE_PGSSLROOTCERT=/etc/clrs-staging/postgres-ca.pem
RESTORE_AGE_IDENTITY_FILE=/secure/offline/backup-identity.txt
