# Create /etc/clrs-staging/media-backup.env outside git.
# Use a separate S3 key with read access to media and write access to backups.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
S3_ENDPOINT=https://s3.example.invalid
MEDIA_S3_BUCKET=clrs-staging-media
BACKUP_S3_BUCKET=clrs-staging-backups
BACKUP_MEDIA_PREFIX=media/current
