# Create /etc/clrs-staging/media-restore.env outside git on an operator machine.
# Use an S3 key that can read backups and write ONLY an empty test bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
S3_ENDPOINT=https://s3.twcstorage.ru/
TIMEWEB_API_TOKEN=
MEDIA_S3_BUCKET=clrs-staging-media
BACKUP_S3_BUCKET=clrs-staging-backups
RESTORE_S3_BUCKET_ID=
BACKUP_MEDIA_PREFIX=media/current
