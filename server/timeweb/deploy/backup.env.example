# Create /etc/clrs-staging/backup.env outside git. No account login password belongs here.
# Give the backup service a dedicated read-only PostgreSQL user and an S3 key
# allowed to write new backup objects and read them for checksum verification,
# but not delete them.
PGHOST=postgres.example.invalid
PGPORT=5432
PGUSER=clrs_backup
PGPASSWORD=
PGDATABASE=clrs_staging
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/clrs-staging/postgres-ca.pem
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
S3_ENDPOINT=https://s3.example.invalid
BACKUP_S3_BUCKET=clrs-staging-backups
BACKUP_S3_PREFIX=postgres
BACKUP_AGE_RECIPIENT_FILE=/etc/clrs-staging/backup-recipient.txt
BACKUP_DIR=/var/backups/clrs-staging
