# Copy to /etc/clrs-staging/mysql-restore.env outside git; owner operator or root, mode 0600.
# Dedicated user: grants only on a pre-created, empty clrs_staging. No default_db access.
MYSQL_HOST=db.example.invalid
MYSQL_PORT=3306
MYSQL_USER=clrs_restore
MYSQL_PASSWORD=
MYSQL_DATABASE=clrs_staging
MYSQL_CA_FILE=/etc/clrs-staging/mysql-ca.pem
RESTORE_AGE_IDENTITY_FILE=/secure/offline/backup-identity.txt
