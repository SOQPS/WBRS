# Copy to /etc/clrs-staging/mysql-backup.env outside git; owner backup user or root, mode 0600.
# Dedicated user: read-only grants on clrs_staging only. No default_db access.
MYSQL_HOST=db.example.invalid
MYSQL_PORT=3306
MYSQL_USER=clrs_backup
MYSQL_PASSWORD=
MYSQL_DATABASE=clrs_staging
MYSQL_CA_FILE=/etc/clrs-staging/mysql-ca.pem
BACKUP_AGE_RECIPIENT_FILE=/etc/clrs-staging/backup-recipient.txt
BACKUP_DIR=/var/backups/clrs-staging
